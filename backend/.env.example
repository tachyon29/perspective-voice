# Same Supabase project as the frontend. Use the anon/publishable key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI providers. Keep their API keys server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b-conversations

# Local code execution runs inside Docker with resource limits.
CODE_RUNNER_IMAGE=python:3.12-alpine
CODE_RUNNER_TIMEOUT_SECONDS=5
